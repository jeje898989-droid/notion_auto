# gws-skill credentials - copy to .env and fill in. Never commit .env.
# OAuth client (Desktop app) from Google Cloud Console > Google Auth Platform > Clients
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=
# GCP project used for quota/billing (the project that owns the OAuth client)
GOOGLE_WORKSPACE_PROJECT_ID=
# Comma-separated OAuth scopes requested by scripts/login.sh
GWS_SCOPES=https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive
# Optional: override config dir (default ~/.config/gws)
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR=
